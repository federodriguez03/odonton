# Copiar este archivo a .env y completar con valores locales.
# No usar credenciales reales en este archivo de ejemplo.

# PostgreSQL
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=cambiar_en_entorno_local
DB_NAME=odonton_db
DB_PORT=5432

# Pool de conexiones
DB_POOL_MIN=2
DB_POOL_MAX=10

# Ambiente y servidor
NODE_ENV=development
PORT=3000

# JWT
JWT_SECRET=cambiar_por_un_secreto_largo
JWT_EXPIRES_IN=8h

# WhatsApp Web local (whatsapp-web.js)
WHATSAPP_AUTO_START=false
WHATSAPP_CLEAN_STALE_BROWSER=true
WHATSAPP_SESSION_NAME=odonton
WHATSAPP_SESSION_TIMEOUT_MINUTES=10
WHATSAPP_SAFE_MODE=false
WHATSAPP_ALLOWED_NUMBERS=549351XXXXXXXX,549351YYYYYYYY
DEFAULT_COUNTRY_CODE=54
DEFAULT_MOBILE_PREFIX=9

# Recordatorios automaticos por WhatsApp Web
REMINDERS_ENABLED=false
REMINDER_WINDOW_HOURS=24
WHATSAPP_REMINDER_INTERVAL_MINUTES=10
REMINDERS_BATCH_SIZE=50

# Reprogramacion por token temporal
REPROGRAM_TOKEN_HOURS=24
REPROGRAM_BASE_URL=http://localhost:5173/reprogramar-turno

# Autogestion de solicitud/cancelacion/reprogramacion de turnos
AUTOGESTION_TOKEN_HOURS=2
AUTOGESTION_BASE_URL=http://localhost:5173/autogestion/solicitar-turno
AUTOGESTION_CANCEL_BASE_URL=http://localhost:5173/autogestion/cancelar-turno
AUTOGESTION_CANCEL_MIN_HOURS=24
AUTOGESTION_REPROGRAM_MIN_HOURS=24

# Horario de atencion (24h)
WORKDAY_START_HOUR=8
WORKDAY_END_HOUR=20
