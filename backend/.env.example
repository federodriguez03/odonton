# Copiar este archivo a .env y completar con valores locales.
# No usar credenciales reales en este archivo de ejemplo.

# PostgreSQL
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=cambiar_en_entorno_local
DB_NAME=odonton_db
DB_PORT=5432

# Pool de conexiones
DB_POOL_MIN=2
DB_POOL_MAX=10

# Ambiente y servidor
NODE_ENV=development
PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Cantidad exacta de proxies administrados delante de Node. Mantener 0 sin proxy confiable.
TRUST_PROXY_HOPS=0
JSON_BODY_LIMIT=1mb
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
READINESS_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=15000

# JWT
JWT_SECRET=cambiar_por_un_secreto_largo
JWT_EXPIRES_IN=8h

# WhatsApp Web local (whatsapp-web.js)
WHATSAPP_AUTO_START=false
WHATSAPP_CLEAN_STALE_BROWSER=true
WHATSAPP_SESSION_NAME=odonton
WHATSAPP_SESSION_TIMEOUT_MINUTES=10
WHATSAPP_SAFE_MODE=true
WHATSAPP_ALLOWED_NUMBERS=549351XXXXXXXX,549351YYYYYYYY
WHATSAPP_POLLING_ENABLED=false
WHATSAPP_RECOVER_MISSED_TURNOS=false
WHATSAPP_RECOVERY_MAX_AGE_MINUTES=120
WHATSAPP_POLL_INTERVAL_SECONDS=5
WHATSAPP_DEBUG=false
DEFAULT_COUNTRY_CODE=54
DEFAULT_MOBILE_PREFIX=9

# Recordatorios automaticos por WhatsApp Web
REMINDERS_ENABLED=false
REMINDER_WINDOW_HOURS=24
WHATSAPP_REMINDER_INTERVAL_MINUTES=10
WHATSAPP_REMINDER_BATCH_SIZE=25

# Alias admitidos por compatibilidad; no son necesarios si se usan los nombres anteriores.
# AUTOGESTION_WHATSAPP_SESSION_MINUTES=10
# REMINDER_HOURS_BEFORE=24
